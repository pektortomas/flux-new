# Set these in RunPod's environment editor. Never bake tokens into the image.
HF_TOKEN=
MODEL_PROFILES=quality,fast
TEXT_ENCODER_PRECISION=fp8
MAJA_TRIGGER=maja
MAJA_STRENGTH=1.0
ENABLE_SNAPSHOT=1
SNAPSHOT_STRENGTH=0.35
# Maja is mandatory and defaults to the pinned TommyPekk/maja_v2/Maja.safetensors.
# MAJA_SOURCE=https://huggingface.co/TommyPekk/maja_v2/resolve/main/Maja.safetensors
ENABLE_CONSISTENCY=0
CONSISTENCY_STRENGTH=0.35
CIVITAI_TOKEN=
EXTRA_LORAS_JSON=[]
RESERVE_VRAM_GB=2
